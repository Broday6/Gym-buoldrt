# Config + analytics store (required).
DATABASE_URL=postgres://compass:compass@localhost:5432/compass

# Retrieval core. With TYPESENSE_HOST unset the server falls back to the local
# SQLite/FTS5 dev engine, which needs no external service.
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=dev-typesense-key

PORT=3100
LOG_LEVEL=info

# Disables API-key checks. Local development only — never set this in production.
COMPASS_DEV_OPEN=0
