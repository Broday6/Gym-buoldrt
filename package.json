{
  "name": "compass-search",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted e-commerce search, merchandising and product discovery platform",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "a11y": "node packages/demo/a11y.mjs && COMPASS_A11Y_THEME=dark node packages/demo/a11y.mjs",
    "app": "tsx packages/server/src/cli/app.ts",
    "backup": "tsx packages/server/src/cli/backup.ts",
    "bench": "tsx packages/server/src/cli/bench.ts",
    "browser-smoke": "node packages/demo/browser-smoke.mjs",
    "build": "tsc -b",
    "build:browser": "tsx packages/demo/browser/build.ts",
    "demo": "npm run seed && npm run dev",
    "dev": "tsx watch packages/server/src/server.ts",
    "keys": "tsx packages/server/src/cli/keys.ts",
    "migrate": "tsx packages/server/src/cli/migrate.ts",
    "openapi": "tsx packages/server/src/cli/openapi.ts",
    "query": "tsx packages/server/src/cli/query.ts",
    "reindex": "tsx packages/server/src/cli/reindex.ts",
    "seed": "tsx packages/demo/seed.ts",
    "start": "node --experimental-sqlite packages/server/dist/server.js",
    "test": "tsx --test packages/server/test/*.test.ts",
    "typecheck": "tsc -b --pretty false",
    "ui-smoke": "node packages/demo/ui-smoke.mjs",
    "ui-smoke:admin": "node packages/admin/ui-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.3",
    "csv-parse": "^5.6.0",
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "typesense": "^2.0.0"
  }
}
